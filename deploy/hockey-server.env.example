# Copy to /etc/hockey-server/hockey-server.env and replace every CHANGE_ME.
SERVER_PORT=8080
DB_URL=jdbc:mysql://127.0.0.1:3306/hockey_db?serverTimezone=UTC
DB_USERNAME=hockey_app
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_POOL_SIZE=10
DB_MIN_IDLE=2
DB_DDL_AUTO=update
JWT_SECRET=CHANGE_ME_BASE64_ENCODED_32_BYTE_SECRET
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=30d
WEBSOCKET_ALLOWED_ORIGINS=https://hockey-api.example.com
JAVA_OPTS=-Xms128m -Xmx512m

